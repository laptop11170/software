{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/src/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/public/(.*)",
      "headers": { "cache-control": "public, max-age=3600" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
